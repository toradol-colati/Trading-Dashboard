# Copy to /etc/ugt/portal.env and protect it:
#   sudo install -d -m 700 /etc/ugt && sudo install -m 600 portal.env.example /etc/ugt/portal.env
# Find the values by logging in once from a browser with DevTools → Network open:
# take the URL of the login request and its form fields.
PORTAL_URL="https://portal.example.net/login"
PORTAL_METHOD="POST"
PORTAL_FORM="username=CHANGE_ME&password=CHANGE_ME&accept_terms=1"
# PROBE_URL="http://connectivitycheck.gstatic.com/generate_204"
